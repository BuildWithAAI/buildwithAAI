+def _git_remote(dp, depth=0):
+    try:
+        cfg = open(os.path.join(dp, ".git", "config"), encoding="utf-8", errors="ignore").read()
+    except OSError:
+        return ""
+    m = re.search(r'(?m)^\s*url\s*=\s*(\S+)', cfg)
+    url = m.group(1) if m else ""
+    if depth < 2 and url.startswith("/") and os.path.isdir(os.path.join(url, ".git")):
+        return _git_remote(url, depth + 1)  # a local clone of a local clone
+    return url
+
+
+def _public_tracked(dp):
+    """Tracked files of a public-repo checkout at dp (absolute paths), or an empty set."""
+    url = re.sub(r"\.git$", "", _git_remote(dp).lower())
+    if not any(r in url for r in PUBLIC_REPO_REMOTES):
+        return set()
+    try:
+        out = subprocess.run(["git", "-C", dp, "ls-files", "-z"], capture_output=True, timeout=20).stdout
+    except (OSError, subprocess.SubprocessError):
+        return set()
+    return {os.path.join(dp, f) for f in out.decode("utf-8", "ignore").split("\0") if f}
+
