diff --git a/projects/lumen/tests/visitorSinks.test.ts b/projects/lumen/tests/visitorSinks.test.ts
new file mode 100644
index 0000000..a0d4967
--- /dev/null
+++ b/projects/lumen/tests/visitorSinks.test.ts
@@ -0,0 +1,46 @@
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { moderateNote } from "../src/brain/social";
+
+const ROOT = new URL("../src", import.meta.url).pathname;
+/** Code that decides, spends, remembers, or prompts. Visitor data must never be imported here. */
+const SINK_DIRS = ["brain", "money", "identity", "research", "integrations", "trading", "shop"];
+
+function files(dir: string): string[] {
+  let out: string[] = [];
+  for (const name of readdirSync(dir)) {
+    const full = join(dir, name);
+    if (statSync(full).isDirectory()) out = out.concat(files(full));
+    else if (/\.(ts|tsx)$/.test(name)) out.push(full);
+  }
+  return out;
+}
+
+describe("visitor data sinks", () => {
+  it("no sink module imports the visitor store or names its tables", () => {
+    const offenders: string[] = [];
+    for (const dir of SINK_DIRS) {
+      let list: string[] = [];
+      try {
+        list = files(join(ROOT, dir));
+      } catch {
+        continue;
+      }
+      for (const file of list) {
+        const text = readFileSync(file, "utf8");
+        if (/from\s+["'][^"']*world\/visitors["']|import\(\s*["'][^"']*world\/visitors["']\s*\)/.test(text)) offenders.push(`${file}: import`);
+        if (/world_visitors|visitor_quarantine|["'`]world_["'`]\s*\+|["'`]visitor_["'`]\s*\+/.test(text)) offenders.push(`${file}: table`);
+      }
+    }
+    expect(offenders).toEqual([]);
+  });
+
+  it("rejects default-ignorable characters in notes", () => {
+    for (const cp of [0x115f, 0x1160, 0xffa0, 0x2061, 0x2064, 0x206a, 0x17b4, 0x1d173, 0x180b, 0xfff0]) {
+      expect(moderateNote(`hi${String.fromCodePoint(cp)}there`, 140).ok).toBe(false);
+    }
+    expect(moderateNote("Meet me by the reef at 10:30, ok?", 140).ok).toBe(true);
+    expect(moderateNote("café naïve 日本語 🙂", 140).ok).toBe(true);
+  });
+});
