diff --git a/projects/lumen/scripts/predeploy-chunk-chain.ts b/projects/lumen/scripts/predeploy-chunk-chain.ts
index c682358..2d5b925 100644
--- a/projects/lumen/scripts/predeploy-chunk-chain.ts
+++ b/projects/lumen/scripts/predeploy-chunk-chain.ts
@@ -1,10 +1,35 @@
-import { openDatabase } from "../src/db/db";
-import { noteChunkChainBroken, verifyChunkChain } from "../src/world/chunkEdits";
+import { existsSync } from "node:fs";
+import { DatabaseSync } from "node:sqlite";
+import { verifyChunkChain } from "../src/world/chunkEdits";
+
+/**
+ * Read-only chain check for a copy of the prod database. It never creates a file,
+ * never runs migrations, and never writes an alert. Exit 1 means do not deploy.
+ */
+function line(event: string, status: number, detail?: string): void {
+  console.log(JSON.stringify({ ts: new Date().toISOString(), event, status, route: "predeploy", ...(detail ? { detail } : {}) }));
+}
 
 const file = process.env.LUMEN_DATA ?? `${process.cwd()}/data/lumen.sqlite`;
-const db = openDatabase(file);
+if (!existsSync(file)) {
+  line("chunk_chain_missing", 500, "LUMEN_DATA does not point at a database file");
+  process.exit(1);
+}
+const db = new DatabaseSync(file, { readOnly: true });
+const table = db.prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'chunk_edits'").get();
+if (!table) {
+  line("chunk_chain_empty", 200, "no chunk_edits table yet");
+  process.exit(0);
+}
+const pending = db.prepare("SELECT 1 FROM pragma_table_info('chunk_edits') WHERE name = 'hash_version'").get()
+  ? Number((db.prepare("SELECT COUNT(*) AS n FROM chunk_edits WHERE hash_version < 2").get() as { n: number }).n)
+  : Number((db.prepare("SELECT COUNT(*) AS n FROM chunk_edits").get() as { n: number }).n);
+if (pending > 0) {
+  line("chunk_chain_needs_migration", 500, "rows on the old hash; boot the new build on a copy first");
+  process.exit(1);
+}
 if (!verifyChunkChain(db)) {
-  noteChunkChainBroken(db);
-  console.log(JSON.stringify({ ts: new Date().toISOString(), event: "chunk_chain_broken", status: 500, route: "predeploy" }));
+  line("chunk_chain_broken", 500);
   process.exit(1);
 }
+line("chunk_chain_ok", 200);
