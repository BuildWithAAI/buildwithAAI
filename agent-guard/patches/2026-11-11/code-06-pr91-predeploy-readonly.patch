diff --git a/projects/lumen/tests/predeployReadonly.test.ts b/projects/lumen/tests/predeployReadonly.test.ts
new file mode 100644
index 0000000..f74cc92
--- /dev/null
+++ b/projects/lumen/tests/predeployReadonly.test.ts
@@ -0,0 +1,55 @@
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdtempSync, rmSync, statSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { openDatabase } from "../src/db/db";
+import { appendChunkEdit } from "../src/world/chunkEdits";
+
+function run(file: string) {
+  return spawnSync(process.execPath, [join("node_modules", "vite-node", "vite-node.mjs"), "scripts/predeploy-chunk-chain.ts"], {
+    env: { PATH: process.env.PATH ?? "", LUMEN_DATA: file },
+    encoding: "utf8",
+    timeout: 60_000,
+  });
+}
+
+function seed(file: string) {
+  const db = openDatabase(file);
+  appendChunkEdit(db, {
+    id: "edit-pd1", atMs: 10, chunkX: 1, chunkY: 1, tileX: 1, tileY: 1, kind: "decor", actor: "zoora", idempotencyKey: "pd1",
+    payload: { buildId: "build-pd01", version: 1, title: "Dock bell", hue: 20, parts: 3, twist: 0.2, form: 1, size: 0.8 },
+  });
+  return db;
+}
+
+describe("predeploy chunk chain check", () => {
+  it("passes a good chain, fails a broken one, and never creates or writes a file", () => {
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    const dir = mkdtempSync(join(tmpdir(), "lumen-predeploy-"));
+    try {
+      const good = join(dir, "good.sqlite");
+      seed(good).close();
+      const before = statSync(good).mtimeMs;
+      expect(run(good).status).toBe(0);
+      expect(statSync(good).mtimeMs).toBe(before);
+
+      const bad = join(dir, "bad.sqlite");
+      const db = seed(bad);
+      db.exec("DROP TRIGGER chunk_edits_no_update");
+      db.exec("UPDATE chunk_edits SET payload = replace(payload, 'Dock bell', 'Evil bell')");
+      db.close();
+      const broken = run(bad);
+      expect(broken.status).toBe(1);
+      expect(broken.stdout).toContain("chunk_chain_broken");
+      expect(Number((openDatabase(bad).prepare("SELECT COUNT(*) AS n FROM owner_alerts").get() as { n: number }).n)).toBe(0);
+
+      const missing = join(dir, "missing.sqlite");
+      expect(run(missing).status).toBe(1);
+      expect(existsSync(missing)).toBe(false);
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+      vi.restoreAllMocks();
+    }
+  }, 60_000);
+});
