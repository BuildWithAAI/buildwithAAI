     db.prepare(
       `INSERT INTO chunk_edits
@@ -481,6 +495,24 @@ export function degradeChunkChain(db: DatabaseSync, now = Date.now()): void {
   console.log(JSON.stringify({ ts: new Date(now).toISOString(), event: "chunk_chain_degraded", status: 500, route: "boot" }));
 }
 
+/**
+ * Leave degraded mode once the chain verifies again (a restore or a repair). Creative and territory
+ * stay as the owner sets them; this only lifts the write freeze and the decor blackout.
+ */
+export function restoreChunkChain(db: DatabaseSync, now = Date.now()): boolean {
+  if (!chunkWritesFrozen(db)) return true;
+  if (!verifyChunkChain(db)) return false;
+  rememberFlag(db, "chunk_chain_broken", "0");
+  db.prepare("INSERT INTO owner_alerts(id, kind, title, detail, created_at) VALUES(?, 'ledger', ?, ?, ?)").run(
+    randomBytes(8).toString("hex"),
+    "Chunk chain verifies again",
+    "The chunk edit chain verifies again. Decor is back and chunk writes are open. Creative building and territory stay as you set them.",
+    now,
+  );
+  console.log(JSON.stringify({ ts: new Date(now).toISOString(), event: "chunk_chain_restored", status: 200, route: "boot" }));
+  return true;
+}
