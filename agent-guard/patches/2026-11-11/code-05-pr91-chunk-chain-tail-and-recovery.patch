+const CHAIN_TAIL = "CHAIN_TAIL";
+
+/** O(1) check before each append: the last row still hashes to what it claims. Boot verifies the rest. */
+function tailVerifies(row: ChunkEditRow): boolean {
+  if (chunkEditBodyHash(row) !== row.bodyHash) return false;
+  return createHash("sha256").update(row.prevHash + row.bodyHash).digest("hex") === row.entryHash;
+}
+
 export function appendChunkEdit(db: DatabaseSync, input: ChunkEditInput): ChunkEditRow {
   if (chunkWritesFrozen(db)) throw new Error("CHAIN");
   const payload = assertInput(input);
