       return appendOnce(db, input, payload);
     } catch (error) {
       const message = error instanceof Error ? error.message : String(error);
+      if (message === CHAIN_TAIL) {
+        // The append rolled back. Freeze outside that transaction so the flag sticks.
+        if (!db.isTransaction) degradeChunkChain(db);
+        throw new Error("CHAIN");
+      }
       if (attempt < 4 && /busy|locked|UNIQUE constraint failed: chunk_edits\.prev_hash/i.test(message)) continue;
