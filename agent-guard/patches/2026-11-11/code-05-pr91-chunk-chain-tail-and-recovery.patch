+++ b/projects/lumen/tests/chunkChainRecovery.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it, vi } from "vitest";
+import { openDatabase } from "../src/db/db";
+import { appendChunkEdit, chunkWritesFrozen, degradeChunkChain, restoreChunkChain, verifyChunkChain } from "../src/world/chunkEdits";
+
+function decor(id: string) {
+  return {
+    id: `edit-${id}`,
+    atMs: 10,
+    chunkX: 1,
+    chunkY: 1,
+    tileX: 1,
+    tileY: 1,
+    kind: "decor" as const,
+    actor: "zoora",
+    idempotencyKey: id,
+    payload: { buildId: `build-${id}`, version: 1, title: "Dock bell", hue: 20, parts: 3, twist: 0.2, form: 1, size: 0.8 },
+  };
+}
+
+describe("chunk chain recovery", () => {
+  it("refuses to append on a tampered tail and freezes writes", () => {
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    const db = openDatabase();
+    appendChunkEdit(db, decor("aaaa1"));
+    appendChunkEdit(db, decor("aaaa2"));
+    db.exec("DROP TRIGGER chunk_edits_no_update");
+    db.exec("UPDATE chunk_edits SET payload = replace(payload, 'Dock bell', 'Evil bell') WHERE id = 'edit-aaaa2'");
+    expect(() => appendChunkEdit(db, decor("aaaa3"))).toThrow(/CHAIN/);
+    expect(chunkWritesFrozen(db)).toBe(true);
+    expect(Number((db.prepare("SELECT COUNT(*) AS n FROM chunk_edits").get() as { n: number }).n)).toBe(2);
+    expect(restoreChunkChain(db)).toBe(false);
+    vi.restoreAllMocks();
+  });
+
+  it("lifts the freeze once the chain verifies again", () => {
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    const db = openDatabase();
+    appendChunkEdit(db, decor("bbbb1"));
+    degradeChunkChain(db);
+    expect(() => appendChunkEdit(db, decor("bbbb2"))).toThrow(/CHAIN/);
+    expect(verifyChunkChain(db)).toBe(true);
+    expect(restoreChunkChain(db)).toBe(true);
+    expect(chunkWritesFrozen(db)).toBe(false);
+    expect(db.prepare("SELECT 1 FROM owner_alerts WHERE title = 'Chunk chain verifies again'").get()).toBeTruthy();
+    expect(appendChunkEdit(db, decor("bbbb2")).id).toBe("edit-bbbb2");
+    vi.restoreAllMocks();
+  });
+});
