# systemd EnvironmentFile syntax, NOT a shell script. Keep actual file root-owned 0600.
# Example intentionally cannot start until the operator supplies a token and origin.
AAI_HOST=127.0.0.1
AAI_PORT=8787
AAI_PUBLIC_MODE=1
AAI_PUBLIC_URL=https://scanner.example
AAI_API_TOKEN=
AAI_DATABASE=/var/lib/aai-scanner/scanner.sqlite3
AAI_RPC_URL=https://api.mainnet-beta.solana.com
AAI_RPC_FALLBACK_URLS=
AAI_PROVIDER_TIMEOUT=10
AAI_TELEGRAM_ENABLED=0
