# Example only. Export variables explicitly; the scanner does not load dotenv files.
AAI_HOST=127.0.0.1
AAI_PORT=8787
AAI_PUBLIC_URL=http://127.0.0.1:8787
AAI_RPC_URL=https://api.mainnet-beta.solana.com
# Optional, operator-approved HTTPS mainnet providers; at most two distinct URLs.
# AAI_RPC_FALLBACK_URLS=https://your-approved-backup-provider.example
AAI_PROVIDER_TIMEOUT=10
AAI_DATABASE=data/scanner.sqlite3
AAI_PUBLIC_MODE=0
# AAI_API_TOKEN: operator-generated URL-safe 32–128 character token, required for remote mode.
# AAI_TELEGRAM_ENABLED=1
# AAI_TELEGRAM_BOT_TOKEN: supply through secure environment configuration.
# AAI_TELEGRAM_ALLOWED_CHAT_IDS: comma-separated authorized private chat IDs.
# AAI_TELEGRAM_EXPECTED_USERNAME: optional expected bot username, e.g. AAIScanBot.
