# Copy to .env.local. Leave money amounts unset until you choose them.
# Credentials alone open nothing. LUMEN_SPEND_ENABLED, LUMEN_SALES_ENABLED, and MINT_ENABLED each need the exact string true.
# Set one to false to stop that path. A missing credential keeps that path off.
# Do not put a card number or a mint private key in this file.

LUMEN_KILL_SWITCH=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
LUMEN_SALES_CHANNELS=
LUMEN_MERCHANT_ALLOWLIST=
LUMEN_APPROVED_PRODUCT_TYPES=
LUMEN_AUTO_APPROVE_CAP_CENTS=
LUMEN_PER_PURCHASE_CAP_CENTS=
LUMEN_DAILY_CAP_CENTS=
LUMEN_MONTHLY_CAP_CENTS=
LUMEN_PRODUCT_MERCHANTS=
LUMEN_PRODUCT_AMOUNT_CENTS=
LUMEN_ART_PRICE_CENTS=
LUMEN_WISH_GUESSES=
LUMEN_CARD_ISSUER=mock
# owner_checkout uses the owner's card outside this app. Set the available dollars. Do not put a card number here.
LUMEN_CARD_AVAILABLE_USD=
# Public wallet for SOL sales. Never a private key.
LUMEN_SOL_RECEIVE_ADDRESS=
LUMEN_SOL_PRICE_URL=
LUMEN_SOL_RPC_URL=

OWNER_PASSWORD_HASH=
OWNER_ACCESS_TOKEN=
OWNER_SESSION_SECRET=
LUMEN_OWNER_NAME=keeper

LUMEN_LLM_BASE_URL=
LUMEN_LLM_API_KEY=
LUMEN_LLM_MODEL=
LUMEN_LLM_QUALITY_MODEL=
LUMEN_READ_ALLOWLIST=
LUMEN_SEARCH_PROVIDER=mock
LUMEN_SEARCH_API_KEY=
LUMEN_RESEARCH_HOUR_MAX=
LUMEN_RESEARCH_DAY_MAX=
LUMEN_TICK_MS=8000
LUMEN_DATA=data/lumen.sqlite
LUMEN_QUIET_HOURS=0-6
# none ignores X-Forwarded-For. Use fly behind Fly, or forwarded behind a proxy that appends the client hop.
LUMEN_TRUSTED_PROXY=none
# true locks the desk, hides money, and forces spending off. Use cloudflare or ngrok with a tunnel.
LUMEN_PUBLIC_MODE=
LUMEN_ALERT_EMAIL_TO=
LUMEN_ALERT_EMAIL_FROM=
LUMEN_SMTP_HOST=
LUMEN_SMTP_PORT=
LUMEN_SMTP_USER=
LUMEN_SMTP_PASSWORD=
LUMEN_ALERT_TELEGRAM_BOT_TOKEN=
LUMEN_ALERT_TELEGRAM_CHAT_ID=
# Print fulfillment stays off until one of these is set. No live jobs in this build.
LUMEN_FULFILLMENT=off
LUMEN_PRINT_MATERIALS=pla,petg,asa
LUMEN_PRINT_MAX_MM=250
LUMEN_PRINT_MIN_PRICE_CENTS=
LUMEN_PRINT_MAX_PRICE_CENTS=
LUMEN_PRINT_FARM_URL=
LUMEN_PRINT_FARM_TOKEN=
LUMEN_OCTOPRINT_URL=
LUMEN_BAMBU_URL=
LUMEN_PRUSA_URL=
# Zoora system. Off until all three are set. This token is not the owner password and not a world token. The names below stay as they are.
# Visiting agents stay off unless this is the exact string true. Leave it empty.
LUMEN_VISITORS_ENABLED=
# Optional claim ceiling in chunks. Leave it empty. Zoora still grows by at most 4 chunks a day, and never past the world edge.
LUMEN_CLAIM_CEILING=
LUMEN_JARVIS_TOKEN=
LUMEN_JARVIS_WEBHOOK_URL=
LUMEN_JARVIS_WEBHOOK_SECRET=

# Print on demand through Printful. A private token with the orders scope only, for one store, with an expiry.
# Leave empty and nothing is sent. PRINTFUL_STORE_ID is needed only for an account-level token.
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
# Hosts her art may be sent from, comma separated, https only. Empty means no product can be added.
PRINTFUL_ART_HOSTS=
# "outside" if Printful charges your card. "treasury" if it draws on a balance counted in her books.
PRINTFUL_PAID_FROM=outside
# A paid order that would leave less than this percent of its price is refused.
POD_MIN_MARGIN_PERCENT=20
# Countries a print may ship to, comma separated two-letter codes.
POD_SHIP_COUNTRIES=US
# A flat shipping charge added at checkout, in cents. 0 means the price includes shipping.
POD_SHIPPING_CENTS=0

# ---------------------------------------------------------------------------
# Settings the code reads that this file did not list before (added 2026-11-21).
# Each line names the file that reads it. Leave a value empty to keep that part off.
# ---------------------------------------------------------------------------

# Money switches (src/money/rules.ts). Each must be the exact word true. Keys alone open nothing.
# Lets spend, live sales, minting, Solana Pay and live trading run while the public login stays closed.
LUMEN_MONEY_LIVE=
# Live sales: also needs a live Stripe key and the webhook secret.
LUMEN_SALES_ENABLED=
# Read with the sales switch to resolve test or live sales.
LUMEN_SALES_MODE=
# Spending: also needs an issuing key that is not the sales key.
LUMEN_SPEND_ENABLED=
# Card issuer keys (src/money/card.ts).
STRIPE_ISSUING_KEY=
PRIVACY_API_KEY=
# Card statement names, comma separated (src/money/card.ts).
LUMEN_DESCRIPTOR_MAP=
# Optional dollar cap for a listing Zoora publishes. A bad value closes new prices.
LUMEN_LISTING_MAX_USD=
# true also closes the file on a partial refund (src/money/webhook.ts). A dispute always closes it.
LUMEN_REVOKE_ON_PARTIAL_REFUND=
# How long a SOL quote lasts, in milliseconds. Never longer than the built-in ten minutes (src/money/solana.ts).
LUMEN_SOL_QUOTE_MS=

# Her soul file (src/security/soul.ts). The SHA-256 of zoora/SOUL.md. When set, the engine will not run on a
# soul file that differs. Update it after every approved change to the soul.
LUMEN_SOUL_SHA256=

# Economy readers (src/economy/readers.ts). Read only. A Bybit key that can trade, transfer or withdraw is refused.
BYBIT_READ_KEY=
BYBIT_READ_SECRET=
# The venue id in her books that the Bybit reading belongs to.
ECON_BYBIT_VENUE=
# Wallets to watch for the treasury. See docs/VENTURES.md and src/economy/readers.ts for the format.
ECON_WATCH=

# Trading (src/trading/book.ts, docs/TRADING.md). Paper mode is the default.
# Live orders need the exact word true, an https signer you run, its shared secret, and the caps below.
LUMEN_TRADING_LIVE=
LUMEN_TRADE_SIGNER_URL=
LUMEN_TRADE_SIGNER_SECRET=
# The most one trade may risk, in dollars. Unset keeps trade size closed.
LUMEN_TRADE_MAX_USD=
# The most closed loss plus a new trade may add in one day, in dollars.
LUMEN_TRADE_DAILY_LOSS_USD=
# The highest slippage she may ask, in basis points.
LUMEN_TRADE_MAX_SLIPPAGE_BPS=
# Token mints she may or may not trade, comma separated.
LUMEN_TRADE_ALLOW=
LUMEN_TRADE_DENY=
# A pair with less liquidity than this, in dollars, is refused. Unset uses 5000.
LUMEN_RUG_LIQUIDITY_USD=

# Minting (src/money/mint.ts, docs/NFT.md). Needs the exact word true, an https signer and its secret.
MINT_ENABLED=
MINT_SIGNER_URL=
LUMEN_MINT_SIGNER_SECRET=
# mainnet or devnet. Any other value closes minting.
LUMEN_MINT_NETWORK=
# true stops minting.
MINT_KILL=

# Never set these. A private key does not belong in this app, and the feature closes if it finds one:
# LUMEN_TRADING_PRIVATE_KEY, SOLANA_PRIVATE_KEY, MINT_PRIVATE_KEY, MINT_KEYPAIR

# Owner Telegram (src/integrations/telegramOwner.ts, docs/TELEGRAM.md).
LUMEN_TELEGRAM_BOT_TOKEN=
LUMEN_TELEGRAM_OWNER_CHAT_ID=
LUMEN_TELEGRAM_OWNER_USER_ID=
LUMEN_TELEGRAM_WEBHOOK_SECRET=
LUMEN_TELEGRAM_MODE=
# Commands only unless this is the exact word false.
LUMEN_TELEGRAM_COMMANDS_ONLY=
# Optional second model for owner Telegram replies.
LUMEN_XAI_API_KEY=
LUMEN_XAI_MODEL=

# Site and desk.
# The site's own address. Visitor writes are refused unless the request's Origin matches (src/app/api/world/visitorGate.ts).
LUMEN_ORIGIN=
# Shared secret for the desk proxy (src/auth/publicMode.ts).
LUMEN_DESK_SECRET=
# Hosts a wishlist link may point at, comma separated (src/wishlist/board.ts).
LUMEN_WISH_LINK_HOSTS=
# How often queued alerts are sent, in milliseconds. Never faster than 5000 (src/server/engine.ts).
LUMEN_ALERT_DRAIN_MS=

# The world (src/world/sky.ts, src/world/chunkCache.ts).
# Where her sky is: latitude, longitude and time zone.
LUMEN_WORLD_LAT=
LUMEN_WORLD_LON=
LUMEN_WORLD_TZ=
# Seed for the land beyond the island.
LUMEN_WORLD_SEED=
