# Copy to .env.local. Leave money amounts unset until you choose them.
# Unset SPEND_ENABLED, SALES_ENABLED, and MINT_ENABLED turn on when their credentials exist.
# Set one to false to stop that path. A missing credential keeps that path off.
# Do not put a card number or a mint private key in this file.

LUMEN_KILL_SWITCH=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
LUMEN_SALES_CHANNELS=
LUMEN_MERCHANT_ALLOWLIST=
LUMEN_APPROVED_PRODUCT_TYPES=
LUMEN_AUTO_APPROVE_CAP_CENTS=
LUMEN_PER_PURCHASE_CAP_CENTS=
LUMEN_DAILY_CAP_CENTS=
LUMEN_MONTHLY_CAP_CENTS=
LUMEN_PRODUCT_MERCHANTS=
LUMEN_PRODUCT_AMOUNT_CENTS=
LUMEN_ART_PRICE_CENTS=
LUMEN_WISH_GUESSES=
LUMEN_CARD_ISSUER=mock

OWNER_PASSWORD_HASH=
OWNER_ACCESS_TOKEN=
OWNER_SESSION_SECRET=
LUMEN_OWNER_NAME=keeper

LUMEN_LLM_BASE_URL=
LUMEN_LLM_API_KEY=
LUMEN_LLM_MODEL=
LUMEN_LLM_QUALITY_MODEL=
LUMEN_READ_ALLOWLIST=
LUMEN_SEARCH_PROVIDER=mock
LUMEN_SEARCH_API_KEY=
LUMEN_RESEARCH_HOUR_MAX=
LUMEN_RESEARCH_DAY_MAX=
LUMEN_TICK_MS=8000
LUMEN_DATA=data/lumen.sqlite
LUMEN_QUIET_HOURS=0-6
# none ignores X-Forwarded-For. Use fly behind Fly, or forwarded behind a proxy that appends the client hop.
LUMEN_TRUSTED_PROXY=none
# true locks the desk, hides money, and forces spending off. Use cloudflare or ngrok with a tunnel.
LUMEN_PUBLIC_MODE=
LUMEN_ALERT_EMAIL_TO=
LUMEN_ALERT_EMAIL_FROM=
LUMEN_SMTP_HOST=
LUMEN_SMTP_PORT=
LUMEN_SMTP_USER=
LUMEN_SMTP_PASSWORD=
LUMEN_ALERT_TELEGRAM_BOT_TOKEN=
LUMEN_ALERT_TELEGRAM_CHAT_ID=
# Print fulfillment stays off until one of these is set. No live jobs in this build.
LUMEN_FULFILLMENT=off
LUMEN_PRINT_MATERIALS=pla,petg,asa
LUMEN_PRINT_MAX_MM=250
LUMEN_PRINT_MIN_PRICE_CENTS=
LUMEN_PRINT_MAX_PRICE_CENTS=
LUMEN_PRINT_FARM_URL=
LUMEN_PRINT_FARM_TOKEN=
LUMEN_OCTOPRINT_URL=
LUMEN_BAMBU_URL=
LUMEN_PRUSA_URL=
# Zoora system. Off until all three are set. This token is not the owner password and not a world token. The names below stay as they are.
LUMEN_JARVIS_TOKEN=
LUMEN_JARVIS_WEBHOOK_URL=
LUMEN_JARVIS_WEBHOOK_SECRET=
